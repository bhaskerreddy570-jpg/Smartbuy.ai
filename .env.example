# PostgreSQL connection string (PostgreSQL 15+ required for Prisma 8)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/smartbuy?schema=public"
# Vercel Neon integration may inject POSTGRES_URL instead of DATABASE_URL.

# Auth.js (generate with: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"
# Production: AUTH_URL="https://smartbuy.ai"

# AI (optional — deterministic fallbacks used when unavailable)
AI_API_KEY=""
AI_API_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"

# Provider API credentials (server-side only — never expose to frontend)
AMAZON_API_KEY=""
AMAZON_API_SECRET=""
AMAZON_ASSOCIATE_TAG=""

FLIPKART_API_KEY=""
FLIPKART_AFFILIATE_ID=""

CROMA_API_KEY=""

# Use mock providers when real credentials are unavailable (default: true in development)
USE_MOCK_PROVIDERS="true"

# Admin / break-glass (server-side only)
# ADMIN_SESSION_SECRET=""
# ADMIN_SESSION_TTL_HOURS="8"
# ADMIN_LOGIN_RATE_LIMIT_MAX="5"
# ADMIN_LOGIN_RATE_LIMIT_WINDOW_MINUTES="15"

# One-time initial ADMIN provisioning — run: npm run admin:bootstrap
# ADMIN_INITIAL_EMAIL="admin@example.com"
# ADMIN_INITIAL_PASSWORD=""
# ADMIN_INITIAL_DISPLAY_NAME="SmartBuy Admin"

# Site branding (pending final brand approval)
NEXT_PUBLIC_SITE_NAME="PROJECT_NAME_PLACEHOLDER"
NEXT_PUBLIC_SITE_TAGLINE="Your personal decision assistant for buying and booking."
NEXT_PUBLIC_SITE_DESCRIPTION="Search, compare, and decide smarter across Indian ecommerce, travel, and ride options."
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Recommendation engine weights (optional overrides)
# CUSTOMER_SCORE_WEIGHT="0.75"
# BUSINESS_SCORE_WEIGHT="0.25"
# MATCH_CONFIDENCE_THRESHOLD="0.85"
# CUSTOMER_DOMINANCE_GAP="0.15"

# Cron job protection for price alert worker
# CRON_SECRET="replace-with-random-secret"

# Affiliate network postback authentication
# AFFILIATE_POSTBACK_SECRET="replace-with-random-secret"
