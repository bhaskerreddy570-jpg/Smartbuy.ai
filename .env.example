# PostgreSQL connection string (PostgreSQL 15+ required for Prisma 8)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/storage?schema=public"

# Auth.js (generate with: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"

# AWS S3 (ap-south-1 Mumbai preferred)
AWS_REGION="ap-south-1"
AWS_S3_BUCKET="your-private-bucket-name"

# Required for local development unless using an IAM role on the host
AWS_ACCESS_KEY_ID="your-access-key-id"
AWS_SECRET_ACCESS_KEY="your-secret-access-key"

# Application limits
DEFAULT_STORAGE_QUOTA_BYTES="10737418240"
MAX_UPLOAD_BYTES="104857600"

# Optional: comma-separated extensions to block in addition to defaults (include leading dot)
# BLOCKED_FILE_EXTENSIONS=".reg,.inf"

# Optional antivirus hook (disabled by default until a provider is approved)
# ANTIVIRUS_SCAN_ENABLED="false"
# ANTIVIRUS_PROVIDER=""

# Admin / break-glass (server-side only; MFA not enabled in current phase)
# ADMIN_SESSION_SECRET=""                 # optional; falls back to AUTH_SECRET
# ADMIN_SESSION_TTL_HOURS="8"
# ADMIN_LOGIN_RATE_LIMIT_MAX="5"
# ADMIN_LOGIN_RATE_LIMIT_WINDOW_MINUTES="15"
# ADMIN_ACCOUNT_LOCK_THRESHOLD="10"
# ADMIN_RECOVERY_TOKEN_TTL_HOURS="1"
# ADMIN_RECOVERY_INITIATE_RATE_LIMIT_MAX="3"
# ADMIN_RECOVERY_COMPLETE_RATE_LIMIT_MAX="5"
# ADMIN_RECOVERY_RATE_LIMIT_WINDOW_MINUTES="15"

# One-time initial ADMIN provisioning — run: npm run admin:bootstrap
# ADMIN_INITIAL_EMAIL=""
# ADMIN_INITIAL_PASSWORD=""
# ADMIN_INITIAL_DISPLAY_NAME=""
#
# Legacy aliases still supported by the bootstrap script:
# ADMIN_BOOTSTRAP_EMAIL=""
# ADMIN_BOOTSTRAP_PASSWORD=""
# ADMIN_BOOTSTRAP_DISPLAY_NAME=""
