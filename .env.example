# PostgreSQL connection string (PostgreSQL 15+ required for Prisma 8)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/storage?schema=public"

# Auth.js (generate with: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"

# AWS S3 (ap-south-1 Mumbai preferred)
AWS_REGION="ap-south-1"
AWS_S3_BUCKET="your-private-bucket-name"

# Required for local development unless using an IAM role on the host
AWS_ACCESS_KEY_ID="your-access-key-id"
AWS_SECRET_ACCESS_KEY="your-secret-access-key"

# Application limits
DEFAULT_STORAGE_QUOTA_BYTES="10737418240"
MAX_UPLOAD_BYTES="104857600"

# Optional: comma-separated extensions to block in addition to defaults (include leading dot)
# BLOCKED_FILE_EXTENSIONS=".reg,.inf"

# Optional antivirus hook (disabled by default until a provider is approved)
# ANTIVIRUS_SCAN_ENABLED="false"
# ANTIVIRUS_PROVIDER=""
