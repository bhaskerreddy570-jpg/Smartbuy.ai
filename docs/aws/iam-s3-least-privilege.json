{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "StoragePlatformObjectAccess",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:HeadObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::YOUR-PRIVATE-BUCKET-NAME/users/*"
    },
    {
      "Sid": "StoragePlatformBucketLocation",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::YOUR-PRIVATE-BUCKET-NAME",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["users/*"]
        }
      }
    }
  ]
}
