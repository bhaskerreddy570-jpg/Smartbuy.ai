{
  "name": "storage",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma contract emit && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --experimental-test-module-mocks --import tsx --test src/**/*.test.ts",
    "test:integration": "node --experimental-test-module-mocks --import tsx --test --test-concurrency=1 src/**/*.integration.test.ts",
    "test:admin-security": "node --experimental-test-module-mocks --import tsx --test --test-concurrency=1 src/lib/admin/**/*.test.ts",
    "check:env": "bash scripts/check-env.sh",
    "db:migrate": "bash scripts/apply-migration.sh",
    "db:status": "bash scripts/migration-status.sh",
    "test:e2e-smoke": "node scripts/e2e-smoke.mjs",
    "admin:bootstrap": "node --import tsx scripts/bootstrap-admin.mjs",
    "postinstall": "prisma skills sync || exit 0",
    "contract:emit": "prisma contract emit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@prisma/orm-postgres": "^8.0.0-rc.8",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "next": "16.3.4",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prisma": "^8.0.0-rc.13",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
