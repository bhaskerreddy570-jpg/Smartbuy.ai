        "sql": "CREATE TABLE \"public\".\"customerSecurityEvent\" (\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"eventType\" text NOT NULL,\n  \"id\" uuid NOT NULL,\n  \"ipAddress\" text,\n  \"metadata\" text,\n  \"riskLevel\" text DEFAULT 'INFO' NOT NULL,\n  \"userAgent\" text,\n  \"userId\" uuid NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"customerSecurityEvent_eventType_check_f524d5a3\" CHECK (\"eventType\" IN ('LOGIN_SUCCESS', 'LOGIN_FAILURE', 'LOGOUT', 'PASSWORD_CHANGED', 'SESSION_CREATED', 'SESSION_REVOKED', 'FILE_UPLOAD', 'FILE_DOWNLOAD', 'FILE_DELETE', 'FILE_RESTORE', 'SECURITY_SETTING_CHANGED', 'NEW_DEVICE_DETECTED', 'UNUSUAL_ACTIVITY')),\n  CONSTRAINT \"customerSecurityEvent_riskLevel_check_0cbc839c\" CHECK (\"riskLevel\" IN ('INFO', 'LOW', 'MEDIUM'))\n)",
        "params": []
      }
    ],
