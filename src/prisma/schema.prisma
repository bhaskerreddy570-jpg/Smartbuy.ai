// Cloud Storage Platform data contract (Prisma 8)

enum FileStatus {
  PENDING
  READY
}

enum FileSecurityMode {
  NORMAL
  SECURE
}

enum FileCategory {
  CONTACTS
  IMAGES
  VIDEOS
  DOCUMENTS
  OTHER
}

enum StorageProviderKind {
  S3
}

enum Plan {
  FREE
  BASIC
  PRO
  BUSINESS
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
  EXPIRED
}

enum BillingPeriod {
  MONTHLY
  ANNUAL
}

enum AdminRole {
  ADMIN
}

enum AdminAuditAction {
  ADMIN_LOGIN_SUCCESS
  ADMIN_LOGIN_FAILED
  ADMIN_LOGOUT
  ADMIN_SESSION_REVOKED
  ADMIN_PASSWORD_CHANGED
  CUSTOMER_ACCOUNT_LOCKED
  CUSTOMER_ACCOUNT_UNLOCKED
  STORAGE_LIMIT_CHANGED
  MAX_FILE_SIZE_CHANGED
  BANDWIDTH_LIMIT_CHANGED
  CUSTOMER_PLAN_CHANGED
  CUSTOMER_LOCKED
  CUSTOMER_UNLOCKED
  CUSTOMER_RECOVERY
  RECOVERY_TOKEN_ISSUED
  RECOVERY_TOKEN_USED
  RECOVERY_REQUEST_DENIED
  BACKUP_REQUESTED
  DATA_RECOVERY_REQUESTED
  CONTACT_BACKUP_VIEWED
  MOBILE_DEVICE_REVOKED
}

enum MobilePlatform {
  ANDROID
  IOS
}

enum ContactMappingSyncState {
  SYNCED
  PENDING
  CONFLICT
  PAUSED
}

enum ContactConflictResolution {
  KEEP_DEVICE
  KEEP_CLOUD
  MERGE
  DEFER
}

model PlanConfiguration {
  plan Plan @id
  displayName String
  storageQuotaBytes BigInt
  maxFileSizeBytes BigInt
  monthlyBandwidthLimitBytes BigInt
  active Boolean @default(true)
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model User {
  id           Uuid     @id @default(uuid())
  name         String?
  email        String   @unique
  passwordHash String
  assignedPlan Plan @default(FREE)
  storageQuotaOverride BigInt?
  maxFileSizeOverride BigInt?
  monthlyBandwidthLimitOverride BigInt?
  storageQuota BigInt
  storageUsed  BigInt   @default(0)
  maxFileSizeBytes BigInt
  monthlyBandwidthLimitBytes BigInt
  monthlyBandwidthUsedBytes BigInt @default(0)
  bandwidthPeriodStart TimestamptzString?
  lockedAt     TimestamptzString?
  lockReason   String?
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()

  files         File[]
  folders       Folder[]
  subscriptions Subscription[]
  cloudContacts CloudContact[]
  customerDevices CustomerDevice[]
  contactBackupSettings ContactBackupSettings?
}

model File {
  id           Uuid       @id @default(uuid())
  userId       Uuid
  name         String
  originalName String
  storageKey   String     @unique
  size         BigInt
  mimeType     String
  status       FileStatus
  category     FileCategory      @default(OTHER)
  storageProvider StorageProviderKind @default(S3)
  storageNamespace String          @default("default")
  starred      Boolean           @default(false)
  securityMode FileSecurityMode  @default(NORMAL)
  encryptionFormatVersion String?
  encryptionAlgorithm String?
  encryptionKdf String?
  encryptionSalt String?
  encryptionIv String?
  plaintextSize BigInt?
  folderId     Uuid?
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()
  deletedAt    TimestamptzString?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder Folder? @relation(fields: [folderId], references: [id])

  @@index([userId])
  @@index([folderId])
  @@index([userId, status])
  @@index([userId, category])
  @@index([userId, category, status])
  @@index([userId, starred])
}

model Folder {
  id        Uuid     @id @default(uuid())
  userId    Uuid
  name      String
  parentId  Uuid?
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   Folder?  @relation("FolderTree", fields: [parentId], references: [id])
  children Folder[] @relation("FolderTree")
  files    File[]

  @@index([userId])
  @@index([parentId])
}

model Subscription {
  id            Uuid               @id @default(uuid())
  userId        Uuid
  plan          Plan
  status        SubscriptionStatus
  storageQuota  BigInt
  billingPeriod BillingPeriod?
  startDate     TimestamptzString  @default(now())
  renewalDate   TimestamptzString?
  cancelledAt   TimestamptzString?
  createdAt     TimestamptzString  @default(now())
  updatedAt     temporal.updatedAtString()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AdminUser {
  id                     Uuid              @id @default(uuid())
  email                  String            @unique
  passwordHash           String
  displayName            String?
  role                   AdminRole         @default(ADMIN)
  lockedAt               TimestamptzString?
  lockReason             String?
  failedLoginAttempts    Int               @default(0)
  lastFailedLoginAt      TimestamptzString?
  mfaEnabled             Boolean           @default(false)
  mfaSecretEnc           String?
  recoveryTokenHash      String?
  recoveryTokenExpiresAt TimestamptzString?
  lastLoginAt            TimestamptzString?
  createdAt              TimestamptzString @default(now())
  updatedAt              temporal.updatedAtString()

  sessions    AdminSession[]
  auditLogs   AdminAuditLog[]

  @@index([role])
}

model AdminSession {
  id          Uuid              @id @default(uuid())
  adminUserId Uuid
  tokenHash   String            @unique
  expiresAt   TimestamptzString
  ipAddress   String?
  userAgent   String?
  createdAt   TimestamptzString @default(now())
  revokedAt   TimestamptzString?

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([expiresAt])
}

model AdminAuditLog {
  id          Uuid             @id @default(uuid())
  adminUserId Uuid?
  action      AdminAuditAction
  targetType  String?
  targetId    String?
  metadata    String?
  ipAddress   String?
  userAgent   String?
  createdAt   TimestamptzString @default(now())

  adminUser AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([adminUserId])
  @@index([action])
  @@index([createdAt])
}

model AdminLoginAttempt {
  id          Uuid              @id @default(uuid())
  email       String
  ipAddress   String
  attemptedAt TimestamptzString @default(now())
  success     Boolean           @default(false)

  @@index([email, attemptedAt])
  @@index([ipAddress, attemptedAt])
}

model ContactBackupSettings {
  userId                Uuid              @id
  automaticBackupEnabled Boolean          @default(false)
  lastSuccessfulBackupAt TimestamptzString?
  lastSyncStatus        String?
  lastSyncError         String?
  contactCount          Int               @default(0)
  contactStorageBytes   BigInt            @default(0)
  syncCursor            BigInt            @default(0)
  createdAt             TimestamptzString @default(now())
  updatedAt             temporal.updatedAtString()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CustomerDevice {
  id          Uuid              @id @default(uuid())
  userId      Uuid
  platform    MobilePlatform
  displayName String
  appVersion  String?
  automaticBackupEnabled Boolean @default(true)
  lastSeenAt  TimestamptzString?
  lastSyncAt  TimestamptzString?
  lastSyncStatus String?
  revokedAt   TimestamptzString?
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokens   CustomerDeviceToken[]
  mappings DeviceContactMapping[]

  @@index([userId])
  @@index([userId, revokedAt])
}

model CustomerDeviceToken {
  id         Uuid              @id @default(uuid())
  deviceId   Uuid
  tokenHash  String            @unique
  expiresAt  TimestamptzString
  createdAt  TimestamptzString @default(now())
  revokedAt  TimestamptzString?

  device CustomerDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([expiresAt])
}

model CloudContact {
  id            Uuid              @id @default(uuid())
  userId        Uuid
  displayName   String?
  payloadJson   String
  payloadBytes  BigInt
  syncVersion   BigInt
  securityMode  FileSecurityMode  @default(NORMAL)
  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()
  deletedAt     TimestamptzString?

  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  mappings  DeviceContactMapping[]
  conflicts ContactSyncConflict[]

  @@index([userId])
  @@index([userId, deletedAt])
  @@index([userId, syncVersion])
}

model DeviceContactMapping {
  id                 Uuid                  @id @default(uuid())
  deviceId           Uuid
  cloudContactId     Uuid
  localContactId     String
  lastKnownVersion   BigInt
  lastLocalModified  TimestamptzString?
  syncState          ContactMappingSyncState @default(PENDING)
  createdAt          TimestamptzString     @default(now())
  updatedAt          temporal.updatedAtString()

  device       CustomerDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  cloudContact CloudContact   @relation(fields: [cloudContactId], references: [id], onDelete: Cascade)

  @@unique([deviceId, localContactId])
  @@index([deviceId])
  @@index([cloudContactId])
}

model ContactSyncConflict {
  id                 Uuid                     @id @default(uuid())
  userId             Uuid
  cloudContactId     Uuid
  deviceId           Uuid?
  devicePayloadJson  String
  cloudPayloadJson   String
  resolution         ContactConflictResolution?
  resolvedAt         TimestamptzString?
  createdAt          TimestamptzString        @default(now())
  updatedAt          temporal.updatedAtString()

  cloudContact CloudContact @relation(fields: [cloudContactId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([cloudContactId])
  @@index([userId, resolvedAt])
}
