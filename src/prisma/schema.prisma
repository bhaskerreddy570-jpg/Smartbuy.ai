// SmartBuy AI — production data contract (Prisma 8)

enum UserRole {
  CUSTOMER
  ADMIN
}

enum ProviderStatus {
  ACTIVE
  INACTIVE
  PENDING_APPROVAL
  NOT_SUPPORTED
}

enum DataAcquisitionMode {
  OFFICIAL_API
  AFFILIATE_API
  PRODUCT_FEED
  AUTHORIZED_PARTNER
  PERMITTED_PUBLIC
  LICENSED_THIRD_PARTY
  CUSTOMER_PROVIDED
  MANUAL_CHECK
  MOCK
}

enum ProviderCategory {
  ECOMMERCE
  TRAVEL_FLIGHT
  TRAVEL_HOTEL
  TRAVEL_BUS
  TRAVEL_TRAIN
  CAR_RENTAL
  RIDE_SERVICE
  OTHER
}

enum AffiliateProgramStatus {
  ACTIVE
  PENDING
  INACTIVE
}

enum CommissionState {
  CLICKED
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
  PAID
}

enum DataFreshness {
  LIVE
  CACHED
  HISTORICAL
  CUSTOMER_PROVIDED
  ESTIMATED
  UNAVAILABLE
}

enum PriceAlertStatus {
  ACTIVE
  TRIGGERED
  CANCELLED
  EXPIRED
}

enum SearchStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  PARTIAL
}

enum AdminRole {
  ADMIN
  SUPER_ADMIN
}

enum AdminAuditAction {
  ADMIN_LOGIN_SUCCESS
  ADMIN_LOGIN_FAILED
  ADMIN_LOGOUT
  ADMIN_SESSION_REVOKED
  ADMIN_PASSWORD_CHANGED
  RECOVERY_TOKEN_ISSUED
  RECOVERY_TOKEN_USED
  RECOVERY_REQUEST_DENIED
  PROVIDER_UPDATED
  MERCHANT_UPDATED
  AFFILIATE_RULE_UPDATED
  PRODUCT_MERGED
  PRODUCT_UNMERGED
  SETTINGS_UPDATED
  USER_LOCKED
  USER_UNLOCKED
}

enum NotificationChannel {
  EMAIL
  PUSH
  IN_APP
}

model User {
  id           Uuid     @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  phone        String?
  lockedAt     TimestamptzString?
  lockReason   String?
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()

  sessions         UserSession[]
  searches         Search[]
  savedProducts    SavedProduct[]
  savedSearches    SavedSearch[]
  priceAlerts      PriceAlert[]
  affiliateClicks  AffiliateClick[]
  submittedFares   CustomerSubmittedFare[]
  screenshots      CustomerScreenshot[]
  notificationPrefs NotificationPreference?
}

model UserSession {
  id               Uuid              @id @default(uuid())
  userId           Uuid
  sessionTokenHash String            @unique
  deviceLabel      String?
  ipAddress        String?
  userAgent        String?
  lastActiveAt     TimestamptzString?
  expiresAt        TimestamptzString?
  revokedAt        TimestamptzString?
  createdAt        TimestamptzString @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Provider {
  id                  Uuid                @id @default(uuid())
  slug                String              @unique
  name                String
  category            ProviderCategory
  status              ProviderStatus      @default(PENDING_APPROVAL)
  dataMode            DataAcquisitionMode @default(MOCK)
  apiAvailable        Boolean             @default(false)
  affiliateAvailable  Boolean             @default(false)
  supportedOperations String              @default("[]")
  termsNotes        String?
  commissionNotes   String?
  baseUrl           String?
  allowedDomains    String              @default("[]")
  rateLimitPerMin   Int?
  lastSuccessfulSync TimestamptzString?
  errorCount        Int                 @default(0)
  configJson        String              @default("{}")
  createdAt         TimestamptzString   @default(now())
  updatedAt         temporal.updatedAtString()

  credentials ProviderCredential[]
  merchants   Merchant[]
  listings    MerchantListing[]
  syncJobs    ProviderSyncJob[]

  @@index([status])
  @@index([category])
}

model ProviderCredential {
  id           Uuid              @id @default(uuid())
  providerId   Uuid
  credentialType String
  encryptedValue String
  expiresAt    TimestamptzString?
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
}

model AffiliateProgram {
  id              Uuid                   @id @default(uuid())
  name            String
  network         String?
  status          AffiliateProgramStatus @default(PENDING)
  trackingParam   String?
  cookieDurationDays Int?
  paymentTerms    String?
  createdAt       TimestamptzString    @default(now())
  updatedAt       temporal.updatedAtString()

  merchants Merchant[]
}

model Merchant {
  id                 Uuid              @id @default(uuid())
  providerId         Uuid
  affiliateProgramId Uuid?
  slug               String            @unique
  name               String
  affiliateId        String?
  deepLinkTemplate   String?
  defaultCommissionRate Decimal?
  status             ProviderStatus    @default(ACTIVE)
  configJson         String            @default("{}")
  createdAt          TimestamptzString @default(now())
  updatedAt          temporal.updatedAtString()

  provider         Provider          @relation(fields: [providerId], references: [id])
  affiliateProgram AffiliateProgram? @relation(fields: [affiliateProgramId], references: [id])
  commissionRules  CommissionRule[]
  listings         MerchantListing[]
  affiliateClicks  AffiliateClick[]
  affiliateOrders  AffiliateOrder[]
  priceObservations PriceObservation[]

  @@index([providerId])
}

model CommissionRule {
  id           Uuid              @id @default(uuid())
  merchantId   Uuid
  category     String?
  productId    Uuid?
  ratePercent  Decimal
  newCustomerRate Decimal?
  existingCustomerRate Decimal?
  exclusions   String?
  effectiveFrom TimestamptzString @default(now())
  effectiveTo  TimestamptzString?
  createdAt    TimestamptzString @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@index([category])
}

model Product {
  id            Uuid              @id @default(uuid())
  brand         String?
  model         String?
  title         String
  category      String
  subcategory   String?
  description   String?
  specifications String           @default("{}")
  identifiers   String            @default("{}")
  images        String            @default("[]")
  canonicalAttributes String      @default("{}")
  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()

  variants      ProductVariant[]
  productIds    ProductIdentifier[]
  listings      MerchantListing[]
  savedProducts SavedProduct[]
  priceAlerts   PriceAlert[]
  priceObservations PriceObservation[]
  searchResults SearchResult[]
  recommendations Recommendation[]

  @@index([category])
  @@index([brand])
}

model ProductVariant {
  id        Uuid              @id @default(uuid())
  productId Uuid
  name      String
  attributes String           @default("{}")
  sku       String?
  createdAt TimestamptzString @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductIdentifier {
  id         Uuid              @id @default(uuid())
  productId  Uuid
  type       String
  value      String
  createdAt  TimestamptzString @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([type, value])
  @@index([productId])
}

model MerchantListing {
  id                Uuid              @id @default(uuid())
  canonicalProductId Uuid?
  merchantId        Uuid
  providerId        Uuid
  merchantProductId String
  title             String
  url               String
  affiliateUrl      String?
  price             Decimal?
  mrp               Decimal?
  currency          String            @default("INR")
  availability      String?
  seller            String?
  sellerRating      Decimal?
  warranty          String?
  returnPolicy      String?
  deliveryInfo      String?
  rating            Decimal?
  reviewCount       Int?
  dataFreshness     DataFreshness     @default(LIVE)
  sourceTimestamp   TimestamptzString?
  matchConfidence   Decimal?
  createdAt         TimestamptzString @default(now())
  updatedAt         temporal.updatedAtString()

  product  Product?  @relation(fields: [canonicalProductId], references: [id])
  merchant Merchant  @relation(fields: [merchantId], references: [id])
  provider Provider  @relation(fields: [providerId], references: [id])
  priceObservations PriceObservation[]
  affiliateClicks   AffiliateClick[]
  searchResults     SearchResult[]

  @@unique([merchantId, merchantProductId])
  @@index([canonicalProductId])
  @@index([merchantId])
  @@index([providerId])
}

model PriceObservation {
  id           Uuid              @id @default(uuid())
  productId    Uuid
  merchantId   Uuid
  listingId    Uuid
  price        Decimal
  mrp          Decimal?
  availability String?
  currency     String            @default("INR")
  source       String
  observedAt   TimestamptzString @default(now())

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  merchant Merchant       @relation(fields: [merchantId], references: [id])
  listing MerchantListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([productId, observedAt])
  @@index([listingId])
}

model Search {
  id              Uuid              @id @default(uuid())
  userId          Uuid?
  sessionId       String?
  query           String
  parsedIntent    String            @default("{}")
  category        String?
  status          SearchStatus      @default(PENDING)
  resultCount     Int               @default(0)
  createdAt       TimestamptzString @default(now())
  completedAt     TimestamptzString?

  user            User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  results         SearchResult[]
  recommendations Recommendation[]
  affiliateClicks AffiliateClick[]

  @@index([userId])
  @@index([sessionId])
  @@index([createdAt])
}

model SearchResult {
  id              Uuid              @id @default(uuid())
  searchId        Uuid
  productId       Uuid?
  listingId       Uuid?
  rank            Int
  customerScore   Decimal?
  businessScore   Decimal?
  combinedScore   Decimal?
  badge           String?
  explanation     String?
  createdAt       TimestamptzString @default(now())

  search  Search           @relation(fields: [searchId], references: [id], onDelete: Cascade)
  product Product?         @relation(fields: [productId], references: [id])
  listing MerchantListing? @relation(fields: [listingId], references: [id])

  @@index([searchId])
}

model Recommendation {
  id              Uuid              @id @default(uuid())
  searchId        Uuid
  productId       Uuid
  type            String
  customerScore   Decimal
  businessScore   Decimal
  combinedScore   Decimal
  explanation     String
  savingsAmount   Decimal?
  savingsPercent  Decimal?
  createdAt       TimestamptzString @default(now())

  search  Search  @relation(fields: [searchId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([searchId])
}

model AffiliateClick {
  id                Uuid              @id @default(uuid())
  userId            Uuid?
  sessionId         String?
  searchId          Uuid?
  productId         Uuid?
  listingId         Uuid?
  merchantId        Uuid
  affiliateProgram  String?
  clickId           String            @unique @default(uuid())
  destinationUrl    String
  affiliateUrlId    String?
  deviceInfo        String?
  ipAddress         String?
  createdAt         TimestamptzString @default(now())

  user     User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  search   Search?          @relation(fields: [searchId], references: [id], onDelete: SetNull)
  merchant Merchant         @relation(fields: [merchantId], references: [id])
  listing  MerchantListing? @relation(fields: [listingId], references: [id])
  orders   AffiliateOrder[]

  @@index([userId])
  @@index([merchantId])
  @@index([searchId])
  @@index([createdAt])
}

model AffiliateOrder {
  id              Uuid              @id @default(uuid())
  clickId         Uuid?
  merchantId      Uuid
  externalOrderId String?
  orderAmount     Decimal?
  currency        String            @default("INR")
  orderDate       TimestamptzString?
  createdAt       TimestamptzString @default(now())

  click        AffiliateClick?    @relation(fields: [clickId], references: [id])
  merchant     Merchant           @relation(fields: [merchantId], references: [id])
  commissions  AffiliateCommission[]

  @@index([merchantId])
  @@index([clickId])
}

model AffiliateCommission {
  id                Uuid              @id @default(uuid())
  orderId           Uuid?
  merchantId        Uuid
  state             CommissionState     @default(CLICKED)
  estimatedAmount   Decimal?
  confirmedAmount   Decimal?
  paidAmount        Decimal?
  commissionRate    Decimal?
  currency          String            @default("INR")
  notes             String?
  stateChangedAt    TimestamptzString @default(now())
  createdAt         TimestamptzString @default(now())
  updatedAt         temporal.updatedAtString()

  order AffiliateOrder? @relation(fields: [orderId], references: [id])

  @@index([merchantId])
  @@index([state])
}

model PriceAlert {
  id              Uuid              @id @default(uuid())
  userId          Uuid
  productId       Uuid
  merchantId      Uuid?
  targetPrice     Decimal
  currency        String            @default("INR")
  status          PriceAlertStatus  @default(ACTIVE)
  notificationChannel NotificationChannel @default(EMAIL)
  triggeredAt     TimestamptzString?
  createdAt       TimestamptzString @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([productId])
}

model SavedProduct {
  id        Uuid              @id @default(uuid())
  userId    Uuid
  productId Uuid
  createdAt TimestamptzString @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model SavedSearch {
  id        Uuid              @id @default(uuid())
  userId    Uuid
  query     String
  intent    String            @default("{}")
  createdAt TimestamptzString @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CustomerSubmittedFare {
  id          Uuid              @id @default(uuid())
  userId      Uuid?
  sessionId   String?
  providerSlug String
  fare        Decimal
  currency    String            @default("INR")
  etaMinutes  Int?
  tripDetails String?
  confirmed   Boolean           @default(false)
  createdAt   TimestamptzString @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([sessionId])
}

model CustomerScreenshot {
  id          Uuid              @id @default(uuid())
  userId      Uuid?
  sessionId   String?
  fileName    String
  mimeType    String
  storageKey  String
  extractedData String?
  confirmed   Boolean           @default(false)
  createdAt   TimestamptzString @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([sessionId])
}

model NotificationPreference {
  id        Uuid              @id @default(uuid())
  userId    Uuid              @unique
  email     Boolean           @default(true)
  push      Boolean           @default(false)
  inApp     Boolean           @default(true)
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SystemSetting {
  key       String            @id
  value     String
  updatedAt temporal.updatedAtString()
}

model ProviderSyncJob {
  id          Uuid              @id @default(uuid())
  providerId  Uuid
  status      String
  startedAt   TimestamptzString @default(now())
  completedAt TimestamptzString?
  errorMessage String?
  metadata    String?

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
}

model AdminUser {
  id                     Uuid              @id @default(uuid())
  email                  String            @unique
  passwordHash           String
  displayName            String?
  role                   AdminRole         @default(ADMIN)
  lockedAt               TimestamptzString?
  lockReason             String?
  failedLoginAttempts    Int               @default(0)
  lastFailedLoginAt      TimestamptzString?
  mfaEnabled             Boolean           @default(false)
  mfaSecretEnc           String?
  recoveryTokenHash      String?
  recoveryTokenExpiresAt TimestamptzString?
  lastLoginAt            TimestamptzString?
  createdAt              TimestamptzString @default(now())
  updatedAt              temporal.updatedAtString()

  sessions  AdminSession[]
  auditLogs AdminAuditLog[]
}

model AdminSession {
  id          Uuid              @id @default(uuid())
  adminUserId Uuid
  tokenHash   String            @unique
  expiresAt   TimestamptzString
  ipAddress   String?
  userAgent   String?
  createdAt   TimestamptzString @default(now())
  revokedAt   TimestamptzString?

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
}

model AdminAuditLog {
  id          Uuid             @id @default(uuid())
  adminUserId Uuid?
  action      AdminAuditAction
  targetType  String?
  targetId    String?
  metadata    String?
  ipAddress   String?
  userAgent   String?
  createdAt   TimestamptzString @default(now())

  adminUser AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([adminUserId])
  @@index([action])
  @@index([createdAt])
}

model AdminLoginAttempt {
  id          Uuid              @id @default(uuid())
  email       String
  ipAddress   String
  attemptedAt TimestamptzString @default(now())
  success     Boolean           @default(false)

  @@index([email, attemptedAt])
}
